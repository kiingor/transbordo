NODE_ENV=development
PORT=3080
HOST=127.0.0.1
# Em produção, IP/CIDR da rede do proxy; nunca use redes de clientes.
TRUST_PROXY=127.0.0.1
PUBLIC_URL=http://localhost:3080
DATABASE_PATH=./data/portal.sqlite
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Evolution compartilhada pela equipe. A chave global só fica no servidor.
EVOLUTION_URL=
EVOLUTION_API_KEY=
# Origem exata da API do Signal; não é a URL do painel.
SIGNAL_API_ORIGIN=
# Somente desenvolvimento isolado, nunca em produção.
ALLOW_PRIVATE_NETWORKS=false
# Usados exclusivamente pelo comando npm run bootstrap.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Administrador
